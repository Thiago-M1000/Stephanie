---
import { categorias, destaques, type Servico, type Detalhe } from "../data/treatments";

interface Props {
  /** Título da seção (uma linha, cor brand). */
  titulo?: string;
  /** Texto curto abaixo do título. Opcional. */
  subtitulo?: string;
  /** Foto usada nos cards sem foto (opcional). */
  imagemPadrao?: string;
  /** Texto do botão de cada card. */
  botao?: string;
  /** Link do botão de cada card (ex: `mailto:...`). */
  botaoHref?: string;
  id?: string;
}

const {
  titulo = "Explore our treatments & services.",
  subtitulo = "Discover a considered selection of aesthetic treatments, personalised to your features, goals and individual needs.",
  imagemPadrao,
  botao = "Book Now",
  botaoHref = "#",
  id = "treatments",
} = Astro.props;

interface Item {
  servico: Servico;
  /** Nome da categoria, mostrado acima do nome (só na aba Featured). */
  eyebrow?: string;
}

interface Painel {
  id: string;
  rotulo: string;
  titulo: string;
  aviso?: string;
  itens: Item[];
}

// Procura cada destaque pelo nome, em todas as categorias
const todos = categorias.flatMap((c) => c.servicos.map((servico) => ({ servico, categoria: c.titulo })));
const itensDestaque: Item[] = destaques.flatMap((nome) => {
  const achado = todos.find((t) => t.servico.nome === nome);
  return achado ? [{ servico: achado.servico, eyebrow: achado.categoria }] : [];
});

const paineis: Painel[] = [
  { id: "featured", rotulo: "Featured", titulo: "Featured", itens: itensDestaque },
  ...categorias.map((c) => ({
    id: c.id,
    rotulo: c.rotulo ?? c.titulo,
    titulo: c.titulo,
    aviso: c.aviso,
    itens: c.servicos.map((servico) => ({ servico })),
  })),
];
---

<section data-treatments id={id} class="scroll-mt-4 bg-surface px-[20px] py-[64px] text-ink md:px-[96px] md:py-[82px]">
  <div class="reveal mx-auto max-w-[1000px]">

    <!-- Título: uma linha, toda em azul -->
    <h2 class="text-center font-sans text-[30px] font-[600] leading-[1.15] tracking-[-0.03em] text-brand md:text-[46px]">
      {titulo}
    </h2>

    {subtitulo && (
      <p class="mx-auto mt-[16px] max-w-[600px] text-center font-sans text-[17px] leading-[1.5] text-ink/80 md:text-[20px]">
        {subtitulo}
      </p>
    )}

    <!-- Abas: uma linha com rolagem horizontal (setas no desktop, esfumaçado nas bordas) -->
    <div class="relative -mx-[20px] mt-[32px] md:mx-0 md:mt-[48px]">

      <button
        type="button"
        data-arrow="prev"
        aria-label="Previous categories"
        class="absolute left-0 top-1/2 z-20 hidden h-[36px] w-[36px] -translate-y-1/2 items-center justify-center rounded-full border border-brand/20 bg-white text-brand opacity-0 shadow-[0_6px_16px_-6px_rgba(0,0,0,0.3)] transition-all duration-300 hover:bg-brand hover:text-white md:flex"
        style="pointer-events:none"
        tabindex="-1"
      >
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>

      <button
        type="button"
        data-arrow="next"
        aria-label="Next categories"
        class="absolute right-0 top-1/2 z-20 hidden h-[36px] w-[36px] -translate-y-1/2 items-center justify-center rounded-full border border-brand/20 bg-white text-brand shadow-[0_6px_16px_-6px_rgba(0,0,0,0.3)] transition-all duration-300 hover:bg-brand hover:text-white md:flex"
      >
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>

      <!-- Esfumaçado nas bordas (aparece só do lado que ainda tem abas) -->
      <div data-fade="left" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-[40px] bg-gradient-to-r from-surface to-transparent opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
      <div data-fade="right" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-[40px] bg-gradient-to-l from-surface to-transparent transition-opacity duration-300" aria-hidden="true"></div>

      <div
        role="tablist"
        aria-label="Treatment categories"
        data-scroller
        class="relative flex snap-x snap-proximity gap-[8px] overflow-x-auto px-[20px] py-[4px] md:px-[48px] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {paineis.map((p, i) => (
          <button
            type="button"
            role="tab"
            data-tab={p.id}
            aria-selected={i === 0 ? "true" : "false"}
            class="shrink-0 snap-center whitespace-nowrap rounded-full border border-brand/20 bg-white px-[18px] py-[10px] font-sans text-[16px] font-[600] text-brand transition-colors duration-300 hover:border-brand aria-selected:border-brand aria-selected:bg-brand aria-selected:text-white md:py-[9px] md:text-[16px]"
          >
            {p.rotulo}
          </button>
        ))}
      </div>
    </div>

    {paineis.map((p) => {
      // Só mostra o bloco azul nos cards sem foto se a categoria tiver alguma foto
      const categoriaTemFoto = Boolean(imagemPadrao) || p.itens.some((i) => i.servico.imagem);

      return (
        <div role="tabpanel" data-panel={p.id} class="mt-[24px] md:mt-[32px]">

          <!-- Cabeçalho da categoria: nome + quantidade de serviços -->
          <div class="mb-[20px] flex items-baseline justify-between gap-[12px] md:mb-[24px]">
            <h3 class="font-sans text-[22px] font-[600] leading-[1.2] tracking-[-0.02em] text-brand md:text-[26px]">
              {p.titulo}
            </h3>
            <p class="shrink-0 font-sans text-[15px] text-ink/60">
              {p.itens.length} {p.itens.length === 1 ? "treatment" : "treatments"}
            </p>
          </div>

          {p.aviso && (
            <p class="mx-auto mb-[24px] max-w-[700px] rounded-[16px] border border-accent bg-white px-[20px] py-[14px] text-center font-sans text-[16px] leading-[1.5] text-ink/80 md:text-[17px]">
              {p.aviso}
            </p>
          )}

          <!-- items-stretch: cards da mesma linha ficam com a mesma altura -->
          <div class="grid items-stretch gap-[24px] md:grid-cols-2 md:gap-[20px] lg:grid-cols-3">
            {p.itens.map(({ servico: s, eyebrow }) => {
              const foto = s.imagem ?? imagemPadrao;
              const pos = s.imagem ? s.imagemPos : undefined;
              const posMobile = s.imagem ? s.imagemPosMobile : undefined;
              const mostrarBloco = categoriaTemFoto && !foto;
              const temDetalhes = Boolean(s.detalhes?.length || s.opcoes?.length);

              return (
                <article class="relative flex flex-col overflow-hidden rounded-[24px] bg-white text-ink">

                  {s.selo && (
                    <span class="absolute right-[16px] top-[16px] z-10 rounded-full bg-accent px-[14px] py-[5px] font-sans text-[13px] font-[700] uppercase tracking-[0.04em] text-brand">
                      {s.selo}
                    </span>
                  )}

                  {/* Com foto: mobile 4/3, desktop 166px, com degradê preto embaixo.
                      Sem foto: bloco azul no desktop (só em categorias que têm alguma foto). */}
                  {foto ? (
                    <div class="relative">
                      <img
                        src={foto}
                        alt={s.imagem ? s.nome : ""}
                        loading="lazy"
                        class="treat-img aspect-[4/3] w-full object-cover md:aspect-auto md:h-[166px]"
                        style={`--pos:${pos ?? "50% 50%"};--pos-m:${posMobile ?? pos ?? "50% 50%"}`}
                      />
                      <div
                        class="pointer-events-none absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t from-[#000000] to-transparent opacity-60"
                        aria-hidden="true"
                      ></div>
                    </div>
                  ) : mostrarBloco ? (
                    <div
                      class="hidden h-[166px] w-full items-center justify-center bg-gradient-to-br from-brand to-brand-dark md:flex"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 48 48" class="h-[48px] w-[48px] text-accent" fill="currentColor">
                        <path d="M20 4l3.6 12.4L36 20l-12.4 3.6L20 36l-3.6-12.4L4 20l12.4-3.6L20 4z" />
                        <path d="M37 26l1.8 6.2L45 34l-6.2 1.8L37 42l-1.8-6.2L29 34l6.2-1.8L37 26z" opacity="0.7" />
                      </svg>
                    </div>
                  ) : null}

                  {/* Borda só na parte do texto: sem linha no topo quando há foto/bloco acima */}
                  <div
                    class:list={[
                      "flex flex-1 flex-col border border-brand/15 p-[24px] md:p-[20px]",
                      foto
                        ? "rounded-b-[24px] border-t-0"
                        : mostrarBloco
                          ? "rounded-[24px] md:rounded-b-[24px] md:rounded-t-none md:border-t-0"
                          : "rounded-[24px]",
                    ]}
                  >
                    {eyebrow && (
                      <p class="mb-[6px] font-sans text-[12px] font-[700] uppercase tracking-[0.06em] text-brand/60">
                        {eyebrow}
                      </p>
                    )}

                    <h4
                      class:list={[
                        "font-sans text-[22px] font-[600] leading-[1.2] tracking-[-0.02em] text-brand",
                        // Sem foto e com selo: deixa espaço à direita para o selo não cobrir o título
                        !foto && !mostrarBloco && s.selo && "pr-[90px]",
                        !foto && mostrarBloco && s.selo && "pr-[90px] md:pr-0",
                      ]}
                    >
                      {s.nome}
                    </h4>

                    {s.duracao && (
                      <p class="mt-[8px] flex items-center gap-[6px] font-sans text-[15px] leading-[1.3] text-ink/70">
                        <svg viewBox="0 0 24 24" class="h-[15px] w-[15px] shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="9" />
                          <path d="M12 7v5l3 2" />
                        </svg>
                        <span>{s.duracao}{s.helen ? " with Helen" : ""}</span>
                      </p>
                    )}

                    {s.descricao && (
                      <p class="mt-[12px] font-sans text-[17px] leading-[1.5] text-ink/80 md:mt-[10px] md:text-[16px]">
                        {s.descricao}
                      </p>
                    )}

                    {temDetalhes && (
                      <details class="group/info mt-[12px]">
                        <summary class="inline-flex cursor-pointer list-none items-center gap-[6px] font-sans text-[15px] font-[600] text-brand [&::-webkit-details-marker]:hidden">
                          <span class="group-open/info:hidden">More info</span>
                          <span class="hidden group-open/info:inline">Less info</span>
                          <svg viewBox="0 0 24 24" class="h-[14px] w-[14px] transition-transform duration-300 group-open/info:rotate-180" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 9l6 6 6-6" />
                          </svg>
                        </summary>

                        <div class="mt-[12px] flex flex-col gap-[12px] font-sans text-[15px] leading-[1.55] text-ink/80">
                          {s.detalhes?.map((d: Detalhe) =>
                            typeof d === "string" ? (
                              <p>{d}</p>
                            ) : (
                              <div>
                                {d.titulo && <p class="font-[600] text-brand">{d.titulo}</p>}
                                {d.paragrafos?.map((t) => <p class="mt-[6px]">{t}</p>)}
                                {d.itens && (
                                  <ul class="mt-[6px] flex list-disc flex-col gap-[4px] pl-[20px] marker:text-brand">
                                    {d.itens.map((item) => <li>{item}</li>)}
                                  </ul>
                                )}
                              </div>
                            )
                          )}

                          {s.opcoes && (
                            <ul class="flex flex-col divide-y divide-brand/10">
                              {s.opcoes.map((o) => (
                                <li class="flex items-center justify-between gap-[12px] py-[6px]">
                                  <span>{o.label}</span>
                                  <span class="font-[600] text-brand">{o.preco}</span>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </details>
                    )}

                    {/* Preço (esquerda) + botão (direita), sempre no fim do card */}
                    {(s.preco || botao) && (
                      <div class="mt-auto pt-[28px] md:pt-[24px]">
                        <div class="flex items-center justify-between gap-[16px]">
                          {s.preco && (
                            <p class="whitespace-nowrap font-sans text-[28px] font-[600] leading-[1] tracking-[-0.02em] text-brand md:text-[26px]">
                              {s.preco}
                            </p>
                          )}

                          {botao && (
                            <a
                              href={botaoHref}
                              class:list={[
                                "inline-flex items-center justify-center rounded-[999px] bg-brand px-[16px] py-[8px] font-sans text-[15px] font-[600] text-white transition-all duration-300 hover:bg-brand-dark",
                                !s.preco && "w-full",
                              ]}
                            >
                              {botao}
                            </a>
                          )}
                        </div>
                      </div>
                    )}
                  </div>

                </article>
              );
            })}
          </div>

        </div>
      );
    })}

  </div>
</section>

<style>
  /* Posição da foto: mobile usa --pos-m, desktop usa --pos */
  .treat-img {
    object-position: var(--pos-m);
  }
  @media (min-width: 768px) {
    .treat-img {
      object-position: var(--pos);
    }
  }
</style>

<script>
  // Abas: mostra um painel por vez (sem JS, todos aparecem empilhados)
  document.querySelectorAll<HTMLElement>("[data-treatments]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
    const scroller = root.querySelector<HTMLElement>("[data-scroller]")!;
    const prev = root.querySelector<HTMLButtonElement>('[data-arrow="prev"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-arrow="next"]')!;
    const fadeL = root.querySelector<HTMLElement>('[data-fade="left"]')!;
    const fadeR = root.querySelector<HTMLElement>('[data-fade="right"]')!;

    // Mostra/esconde setas e esfumaçado conforme a posição da rolagem
    const atualizarBordas = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const temEsq = scroller.scrollLeft > 4;
      const temDir = scroller.scrollLeft < max - 4;

      fadeL.style.opacity = temEsq ? "1" : "0";
      fadeR.style.opacity = temDir ? "1" : "0";

      prev.style.opacity = temEsq ? "1" : "0";
      prev.style.pointerEvents = temEsq ? "auto" : "none";
      prev.tabIndex = temEsq ? 0 : -1;

      next.style.opacity = temDir ? "1" : "0";
      next.style.pointerEvents = temDir ? "auto" : "none";
      next.tabIndex = temDir ? 0 : -1;
    };

    // Centraliza a aba escolhida dentro da linha de abas (sem mexer na rolagem da página)
    const centralizar = (tab: HTMLElement) => {
      scroller.scrollTo({
        left: tab.offsetLeft - (scroller.clientWidth - tab.offsetWidth) / 2,
        behavior: "smooth",
      });
    };

    const show = (id: string) => {
      tabs.forEach((t) => {
        const ativa = t.dataset.tab === id;
        t.setAttribute("aria-selected", String(ativa));
        t.tabIndex = ativa ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };

    const selecionar = (tab: HTMLButtonElement) => {
      show(tab.dataset.tab!);
      centralizar(tab);
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => selecionar(t));

      // Setas do teclado navegam entre as categorias
      t.addEventListener("keydown", (e) => {
        const dest =
          e.key === "ArrowRight" ? (i + 1) % tabs.length :
          e.key === "ArrowLeft" ? (i - 1 + tabs.length) % tabs.length :
          -1;
        if (dest < 0) return;
        e.preventDefault();
        tabs[dest].focus();
        selecionar(tabs[dest]);
      });
    });

    prev.addEventListener("click", () => scroller.scrollBy({ left: -scroller.clientWidth * 0.6, behavior: "smooth" }));
    next.addEventListener("click", () => scroller.scrollBy({ left: scroller.clientWidth * 0.6, behavior: "smooth" }));

    scroller.addEventListener("scroll", atualizarBordas, { passive: true });
    window.addEventListener("resize", atualizarBordas);

    // /treatments#dermal-filler abre direto na aba certa
    const hash = location.hash.slice(1);
    const inicial = tabs.find((t) => t.dataset.tab === hash) ?? tabs[0];
    show(inicial.dataset.tab!);
    if (inicial !== tabs[0]) scroller.scrollLeft = inicial.offsetLeft - (scroller.clientWidth - inicial.offsetWidth) / 2;
    requestAnimationFrame(atualizarBordas);
  });
</script>