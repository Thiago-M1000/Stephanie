---
import { SITE, type LinkCard } from "../config/site";

interface Props {
  titulo?: string;
  subtitulo?: string;
  cards?: LinkCard[];
}

const {
  titulo = "Where would you like to start?",
  subtitulo = "Choose the page that fits what you're looking for.",
  cards = SITE.links,
} = Astro.props;

const ehExterno = (href: string) => /^https?:\/\//.test(href);
---

<section id="links" class="scroll-mt-4 bg-surface px-[20px] py-[64px] text-ink md:px-[96px] md:py-[112px]">
  <div class="reveal mx-auto max-w-[700px]">

    <h2 class="text-balance text-center font-sans text-[30px] font-[600] leading-[1.15] text-brand md:text-[44px]">{titulo}</h2>
    <p class="mx-auto mt-[8px] max-w-[460px] text-balance text-center font-sans text-[16px] text-ink/70 md:text-[18px]">{subtitulo}</p>

    <ul class="mt-[28px] flex flex-col gap-[24px] md:mt-[48px] md:gap-[16px]">
      {cards.map((card) => (
        <li class="mx-auto w-full max-w-[720px]">
          <a
            href={card.href}
            target={ehExterno(card.href) ? "_blank" : undefined}
            rel={ehExterno(card.href) ? "noopener" : undefined}
            class="group flex h-[480px] flex-col-reverse overflow-hidden rounded-[24px] bg-brand text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand md:h-[240px] md:flex-row"
          >
            <!-- Texto (esquerda) -->
            <div class="flex min-h-0 min-w-0 flex-[35] flex-col justify-between gap-[12px] p-[18px] md:flex-1 md:gap-[16px] md:p-[32px]">
              <div class="flex items-start justify-between gap-[8px] md:gap-[12px]">
                <span class="text-[13px] leading-tight text-white/60 md:text-[15px]">{card.marca}</span>
                <svg viewBox="0 0 24 24" class="h-[20px] w-[20px] shrink-0 transition-transform duration-300 group-hover:translate-x-[4px] md:h-[26px] md:w-[26px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </div>

              <div>
                <h3 class="font-big text-[32px] font-[700] leading-[1.05] md:text-[42px]">{card.titulo}</h3>
                <p class="mt-[6px] max-w-[340px] text-balance text-[15px] leading-snug text-white/70 md:text-[17px] md:leading-normal">{card.descricao}</p>
              </div>
            </div>

            <!-- Foto (em cima no mobile, à direita no desktop) -->
            <div class="relative min-h-0 w-full flex-[65] overflow-hidden bg-white/10 md:w-[35%] md:flex-none">
              {card.imagem && (
                <picture>
                  {card.imagemMobile && <source media="(max-width: 767px)" srcset={card.imagemMobile} />}
                  <img
                    src={card.imagem}
                    alt={card.imagemAlt ?? ""}
                    loading="lazy"
                    class="card-img absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    style={`--pos-m:${card.imagemPosMobile ?? card.imagemPos ?? "50% 50%"};--pos-d:${card.imagemPos ?? "50% 50%"}`}
                  />
                </picture>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .card-img {
    object-position: var(--pos-m);
  }
  @media (min-width: 768px) {
    .card-img {
      object-position: var(--pos-d);
    }
  }
</style>