---
const ano = new Date().getFullYear();

const links = [
  { nome: "About", href: "#about" },
  { nome: "Instructor", href: "#instructor" },
  { nome: "Curriculum", href: "#curriculum" },
  { nome: "Enroll", href: "#tickets" },
];

const enrollUrl = "https://hanan-s-site-fa4e.thinkific.com/enroll/3582361";
const instagram = "https://instagram.com/seuperfil";
const tiktok = "https://tiktok.com/@seuperfil";
const email = "seu@email.com";

const iconeClasse =
  "flex h-12 w-12 items-center justify-center rounded-full border border-white/20 text-white transition-colors duration-300 hover:bg-[#FF0080] hover:border-[#FF0080]";
---

<footer class="bg-[#050505] text-white px-6 pt-20 pb-8 border-t border-white/10">
  <div class="max-w-6xl mx-auto">

    <div class="grid gap-14 md:grid-cols-[1.5fr_1fr_1fr]">

      <div>
        <p class="font-big text-4xl md:text-5xl font-[700] uppercase leading-[0.95]">
          Hanan <span class="text-[#FF0080]">Brown</span>
        </p>
        <p class="mt-4 max-w-sm text-[18px] leading-relaxed text-white/60">
          The Palace University. An elegant, immersive lash course for artists ready to build a thriving beauty career.
        </p>
        <a
          href={enrollUrl}
          target="_blank"
          rel="noopener"
          class="font-big mt-8 inline-block rounded-full bg-[#FF0080] px-[32px] py-[10px] text-[20px] font-bold text-white transition-colors duration-300 hover:bg-white hover:text-[#FF0080]"
        >
          Enroll now
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="text-sm uppercase tracking-widest text-white/50">Menu</p>
        <ul class="mt-5 space-y-3 text-[18px]">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-white/80 transition-colors duration-300 hover:text-[#FF0080]">
                {link.nome}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="text-sm uppercase tracking-widest text-white/50">Contact</p>
        <div class="mt-5 flex gap-3">
          <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram" class={iconeClasse}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" />
            </svg>
          </a>
          <a href={tiktok} target="_blank" rel="noopener" aria-label="TikTok" class={iconeClasse}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          </a>
          <a href={`mailto:${email}`} aria-label="Email" class={iconeClasse}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </a>
        </div>
      </div>

    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {ano} Hanan Brown. All rights reserved.</p>
      <a href="#" class="transition-colors duration-300 hover:text-white">Back to top ↑</a>
    </div>

  </div>
</footer>