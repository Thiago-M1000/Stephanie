---
interface Props {
  titulo?: string;
  /** Trecho do título que fica na cor de destaque (opcional, precisa existir dentro de `titulo`). */
  tituloDestaque?: string;
  /** Vídeo próprio (arquivo em /public/videos/...). */
  video?: string;
  /** Capa do vídeo (aparece antes do play). */
  poster?: string;
  /** Alternativa ao "video": URL de embed do YouTube/Vimeo (ex: https://www.youtube-nocookie.com/embed/ID). */
  embed?: string;
  /** Proporção do vídeo, "largura / altura". Padrão vertical: "9 / 16". */
  videoProporcao?: string;
  /** Textos à direita do vídeo (embaixo dele no mobile). */
  paragrafos?: string[];
  /** Lista de credenciais exibida abaixo do texto (opcional). */
  credenciais?: string[];
  id?: string;
}

const {
  titulo = "She started from zero and proved what dedication can achieve.",
  tituloDestaque = "what dedication can achieve.",
  video,
  poster,
  embed,
  videoProporcao = "9 / 16",
  paragrafos = [
    "Watching my students grow in confidence, perfect their techniques and leave training feeling ready to offer treatments safely is exactly why I started teaching.",
    "So proud of every student who puts their trust in me to be part of their aesthetics journey.",
  ],
  credenciais = [],
  id = "story",
} = Astro.props;

// Separa o título em: antes / trecho em destaque / depois
const idx = tituloDestaque ? titulo.indexOf(tituloDestaque) : -1;
const antes = idx >= 0 ? titulo.slice(0, idx) : titulo;
const destaque = idx >= 0 ? tituloDestaque : "";
const depois = idx >= 0 ? titulo.slice(idx + (tituloDestaque?.length ?? 0)) : "";
---

<section id={id} class="scroll-mt-4 bg-[#0A1828] px-[20px] py-[64px] text-white md:px-[96px] md:py-[82px]">
  <div class="reveal mx-auto max-w-[900px]">

    <h2 class="mx-auto max-w-[760px] text-balance text-center font-sans text-[30px] font-[600] leading-[1.15] tracking-[-0.03em] text-white md:text-[46px]">{antes}{destaque && <span class="text-accent">{destaque}</span>}{depois}</h2>

    <div class="mt-[32px] grid items-center gap-[32px] md:mt-[56px] md:grid-cols-[300px_1fr] md:gap-[64px]">

      <!-- Vídeo (esquerda) -->
      <div
        class="mx-auto w-full max-w-[300px] overflow-hidden rounded-[24px] bg-black md:max-w-none"
        style={`aspect-ratio:${videoProporcao}`}
      >
        {embed ? (
          <iframe
            src={embed}
            title={titulo}
            class="h-full w-full"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
        ) : (
          video && (
            <video class="h-full w-full object-cover" controls playsinline preload="metadata" poster={poster}>
              <source src={video} />
            </video>
          )
        )}
      </div>

      <!-- Texto + credenciais (direita) -->
      <div>
        {paragrafos.length > 0 && (
          <div class="flex flex-col gap-[16px] font-sans text-[17px] leading-[1.65] text-white/80 md:text-[20px]">
            {paragrafos.map((p) => <p>{p}</p>)}
          </div>
        )}

        {credenciais.length > 0 && (
          <ul class="mt-[28px] flex flex-col gap-[14px] md:mt-[36px]">
            {credenciais.map((c) => (
              <li class="flex items-center gap-[12px] font-sans text-[18px] font-[600] text-white md:text-[20px]">
                <span class="flex h-[28px] w-[28px] shrink-0 items-center justify-center rounded-full bg-white text-[#0A1828]">
                  <svg viewBox="0 0 24 24" class="h-[16px] w-[16px]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                </span>
                {c}
              </li>
            ))}
          </ul>
        )}
      </div>

    </div>
  </div>
</section>