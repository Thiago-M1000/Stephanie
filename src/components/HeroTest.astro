---
/* Hero de tela cheia com foto de fundo e degradê.
   Uso:
     <HeroTest titulo="..." texto="..." foto="/images/img3.webp" fotoPos="50% 25%">
       <Button href="/contact" variante="claro">Texto</Button>
     </HeroTest>
   Tudo que for colocado dentro do <HeroTest> aparece como botões, abaixo do texto.
   Sem "foto", o fundo fica azul-marinho liso.
   Só "titulo" é obrigatório; subtitulo, frase e texto são opcionais.
   Altura: exatamente 100svh. Tamanhos de texto e espaços acompanham a altura da tela (unidade svh),
   então o conteúdo cabe sem estourar. Em telas muito baixas (< 560px) o parágrafo some. */
interface Props {
  titulo: string;
  /** Linha pequena logo abaixo do título (ex: "Beauty • Education • Business") */
  subtitulo?: string;
  /** Frase de destaque em fonte grande, acima do texto */
  frase?: string;
  texto?: string;
  /** Caminho da foto em /public/images */
  foto?: string;
  /** Enquadramento da foto, "X% Y%" (0% topo/esquerda, 100% base/direita) */
  fotoPos?: string;
  /** Degradê sobre a foto, de baixo para cima, em hex.
      Os dois últimos dígitos são a opacidade: FF=100%, B3=70%, 80=50%, 33=20%. */
  degrade?: string;
  /** Degradê escuro no topo, só para a navbar clara ficar legível sobre a foto */
  degradeTopo?: string;
  /** Largura máxima do título (ex: "12ch", "20ch") */
  larguraTitulo?: string;
}

const {
  titulo,
  subtitulo,
  frase,
  texto,
  foto,
  fotoPos = "50% 25%",
  degrade = "linear-gradient(to top, #000000 0%, #000000B3 35%, #00000080 65%, #00000033 100%)",
  degradeTopo = "linear-gradient(to bottom, #00000066 0%, #00000000 22%)",
  larguraTitulo = "12ch",
} = Astro.props;
---

<!-- Com foto: o hero sobe por cima do espaçador da navbar (margem negativa), ocupa a tela toda
     e fica por trás da navbar transparente.
     Sem foto: ocupa a tela descontando a altura da navbar. -->
<section
  data-hero-foto={foto ? "true" : undefined}
  class:list={[
    "relative isolate flex items-end overflow-hidden bg-brand px-5 pb-[max(2rem,5svh)] text-surface md:px-10",
    foto
      ? "-mt-[64px] h-[100svh] min-h-[460px] pt-[calc(64px+2svh)] xl:-mt-[80px] xl:pt-[calc(80px+2svh)]"
      : "h-[calc(100svh-64px)] min-h-[480px] pt-8 xl:h-[calc(100svh-80px)]",
  ]}
>
  {foto && (
    <>
      <img
        src={foto}
        alt=""
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        style={`object-position: ${fotoPos}`}
        fetchpriority="high"
      />
      <div class="absolute inset-0 -z-10" style={`background: ${degradeTopo}, ${degrade}`}></div>
    </>
  )}

  <div class="mx-auto w-full max-w-[1280px]">
    <h1
      class="font-display text-[length:clamp(2.75rem,min(9vw,10.5svh),6rem)] font-light leading-[1] tracking-[-0.025em]"
      style={`max-width: ${larguraTitulo}`}
    >
      {titulo}
    </h1>
    {subtitulo && (
      <p class="mt-[1.5svh] text-[length:clamp(0.9375rem,2.2svh,1.1875rem)] font-medium text-surface/80">{subtitulo}</p>
    )}
    {frase && (
      <p class="mt-[3svh] font-display text-[length:clamp(1.25rem,3.4svh,2.125rem)] font-normal leading-[1.2]">{frase}</p>
    )}
    {texto && (
      <p class:list={["max-w-[58ch] text-[length:clamp(0.9375rem,2.2svh,1.1875rem)] leading-[1.65] text-surface/90 [@media(max-height:560px)]:hidden", frase ? "mt-[1.5svh]" : "mt-[3svh]"]}>{texto}</p>
    )}
    <div class="mt-[3.5svh] flex flex-wrap gap-4">
      <slot />
    </div>
  </div>
</section>