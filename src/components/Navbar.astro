---
import { SITE } from "../config/site";

interface Props {
  /** Nome exibido no logo (padrão: SITE.name). */
  nome?: string;
  nomeHref?: string;
  links?: { nome: string; href: string }[];
  ctaTexto?: string;
  ctaHref?: string;
}

const {
  nome = SITE.name,
  nomeHref = "/",
  links = SITE.nav,
  ctaTexto = SITE.cta.texto,
  ctaHref = SITE.cta.href,
} = Astro.props;

const temCta = Boolean(ctaTexto && ctaHref);

// Página atual, para marcar o link ativo no menu
const atual = Astro.url.pathname.replace(/\/$/, "") || "/";
const estaAtivo = (href: string) =>
  href === "/" ? atual === "/" : atual === href || atual.startsWith(`${href}/`);
---

<nav
  id="navbar"
  class="fixed inset-x-0 top-0 z-20 border-b border-brand/10 bg-surface/85 text-brand backdrop-blur-[16px]"
>
  <div class="mx-auto max-w-[1280px] px-5 md:px-10">

    <!-- Barra principal -->
    <div class="flex h-[64px] items-center justify-between gap-6 xl:h-[80px]">

      <!-- Logo / nome -->
      <a href={nomeHref} class="font-display text-[22px] font-medium leading-none tracking-[-0.01em] whitespace-nowrap xl:text-[25px]">
        {nome}
      </a>

      <!-- Links desktop (a partir de 1280px; abaixo disso entra o menu hambúrguer) -->
      <div class="hidden items-center gap-7 text-[15px] font-medium xl:flex">
        {links.map((link) => {
          const ativo = estaAtivo(link.href);
          return (
            <a
              href={link.href}
              aria-current={ativo ? "page" : undefined}
              class:list={[
                "whitespace-nowrap transition-opacity duration-300 hover:opacity-60",
                ativo && "underline decoration-[1.5px] underline-offset-[10px]",
              ]}
            >
              {link.nome}
            </a>
          );
        })}
      </div>

      <!-- CTA desktop: botão escuro com texto claro -->
      {temCta && (
        <a
          href={ctaHref}
          class="hidden whitespace-nowrap rounded-full bg-brand px-6 py-[10px] text-[15px] font-semibold text-surface transition-colors duration-300 hover:bg-brand-light xl:inline-flex"
        >
          {ctaTexto}
        </a>
      )}

      <!-- Botão do menu mobile -->
      <button
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="-mr-2 flex h-10 w-10 items-center justify-center xl:hidden"
      >
        <span class="relative block h-4 w-6">
          <span class="barra absolute left-0 top-0 h-[2px] w-6 bg-brand transition-transform duration-300"></span>
          <span class="barra absolute bottom-0 left-0 h-[2px] w-6 bg-brand transition-transform duration-300"></span>
        </span>
      </button>

    </div>

    <!-- Menu mobile: links primeiro, botão em largura total no final -->
    <div id="menu-mobile" class="grid xl:hidden">
      <div id="menu-conteudo" class="min-h-0 overflow-hidden" inert>
        <div class="flex flex-col pb-5 font-display text-[26px] font-medium">
          {links.map((link) => {
            const ativo = estaAtivo(link.href);
            return (
              <a
                href={link.href}
                aria-current={ativo ? "page" : undefined}
                class:list={[
                  "menu-link border-t border-brand/10 py-3 transition-opacity duration-300 hover:opacity-60",
                  ativo && "underline decoration-[1.5px] underline-offset-[8px]",
                ]}
              >
                {link.nome}
              </a>
            );
          })}
          {temCta && (
            <a
              href={ctaHref}
              class="menu-link mt-4 w-full rounded-full bg-brand px-6 py-4 text-center font-sans text-[17px] font-semibold text-surface"
            >
              {ctaTexto}
            </a>
          )}
        </div>
      </div>
    </div>

  </div>
</nav>

<!-- Espaçador: ocupa o lugar da navbar (que é fixa) para o conteúdo não ficar por baixo dela.
     Precisa ter a mesma altura da barra principal: 64px no mobile e 80px a partir de 1280px. -->
<div class="h-[64px] xl:h-[80px]" aria-hidden="true"></div>

<!-- Barra de progresso de scroll (para remover: apague este bloco e a função "progresso" no script) -->
<div class="fixed inset-x-0 top-0 z-30 h-[3px]">
  <div
    id="progresso"
    class="h-full w-full origin-left bg-brand will-change-transform"
    style="transform:scaleX(0)"
  ></div>
</div>

<style>
  #navbar {
    transition: background-color 0.3s;
  }

  /* Com o menu mobile aberto, o fundo fica quase opaco para facilitar a leitura */
  #navbar.menu-aberto {
    background-color: rgb(246 241 233 / 0.97);
  }

  #menu-mobile {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  #navbar.menu-aberto #menu-mobile {
    grid-template-rows: 1fr;
  }

  #navbar.menu-aberto .barra:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  #navbar.menu-aberto .barra:nth-child(2) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const nav = document.getElementById("navbar");
  const barra = document.getElementById("progresso");
  const botao = document.getElementById("menu-btn");
  const conteudo = document.getElementById("menu-conteudo");

  const progresso = () => {
    if (!barra) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    barra.style.transform = `scaleX(${p})`;
  };

  const menu = (abrir: boolean) => {
    if (!nav || !botao || !conteudo) return;
    nav.classList.toggle("menu-aberto", abrir);
    botao.setAttribute("aria-expanded", String(abrir));
    botao.setAttribute("aria-label", abrir ? "Close menu" : "Open menu");
    conteudo.toggleAttribute("inert", !abrir);
  };

  botao?.addEventListener("click", () => menu(!nav?.classList.contains("menu-aberto")));
  document.querySelectorAll(".menu-link").forEach((l) => l.addEventListener("click", () => menu(false)));
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1280) menu(false);
  });

  window.addEventListener("scroll", progresso, { passive: true });
  window.addEventListener("resize", progresso);
  progresso();
</script>