---
import { SITE } from "../config/site";

interface Props {
  id?: string;
}

const { id = "footer" } = Astro.props;

const ano = new Date().getFullYear();
const { social, location, credit } = SITE;

// Só aparecem as redes que tiverem link preenchido em SITE.social
const redes = [
  { label: "Instagram", href: social.instagram, externo: true },
  { label: "Facebook", href: social.facebook, externo: true },
  { label: "Email", href: social.email ? `mailto:${social.email}` : "", externo: false },
].filter((rede) => rede.href);
---

<footer id={id} class="bg-brand px-5 pb-8 pt-16 text-surface md:px-10 md:pt-24">
  <div class="mx-auto max-w-[1280px]">

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">

      <!-- Marca -->
      <div class="lg:col-span-5">
        <p class="font-display text-[30px] font-medium leading-[1.1] tracking-[-0.01em] md:text-[36px]">
          {SITE.name}
        </p>
        <p class="mt-3 text-[17px] text-surface/70">{SITE.tagline}</p>
        {location && (
          <p class="mt-6 max-w-[320px] text-[16px] leading-[1.5] text-surface/80">{location}</p>
        )}
      </div>

      <!-- Links rápidos -->
      <nav aria-label="Footer" class="lg:col-span-3">
        <p class="text-[15px] font-semibold text-accent">Quick links</p>
        <ul class="mt-4 flex flex-col gap-3">
          {SITE.nav.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[17px] text-surface/90 transition-colors duration-300 hover:text-accent"
              >
                {link.nome}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- CTA + redes -->
      <div class="lg:col-span-4">
        <p class="text-[15px] font-semibold text-accent">Not sure where to start?</p>
        <p class="mt-4 max-w-[320px] text-[16px] leading-[1.55] text-surface/80">
          There are a few different ways we can work together.
        </p>
        <a
          href={SITE.cta.href}
          class="mt-5 inline-flex rounded-full bg-surface px-7 py-3 text-[16px] font-semibold text-brand transition-colors duration-300 hover:bg-sand"
        >
          {SITE.cta.texto}
        </a>

        {redes.length > 0 && (
          <ul class="mt-8 flex items-center gap-3">
            {redes.map((rede) => (
              <li>
                <a
                  href={rede.href}
                  aria-label={rede.label}
                  target={rede.externo ? "_blank" : undefined}
                  rel={rede.externo ? "noopener noreferrer" : undefined}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-surface/30 text-surface transition-all duration-300 hover:border-accent hover:bg-accent hover:text-brand"
                >
                  {rede.label === "Instagram" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </svg>
                  )}
                  {rede.label === "Facebook" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                    </svg>
                  )}
                  {rede.label === "Email" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

    </div>

    <!-- Linha final -->
    <div class="mt-14 h-px w-full bg-surface/20 md:mt-20"></div>

    <div class="mt-6 flex flex-col gap-4 text-[14px] leading-[1.4] text-surface/60 md:flex-row md:items-center md:justify-between md:text-[15px]">
      <p>© {ano} {SITE.name}. All rights reserved.</p>

      <ul class="flex items-center gap-6">
        {SITE.legal.map((item) => (
          <li>
            <a href={item.href} class="transition-colors duration-300 hover:text-accent">{item.nome}</a>
          </li>
        ))}
      </ul>

      <p>
        {credit.texto}{" "}
        {credit.href ? (
          <a
            href={credit.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-surface/90 transition-colors duration-300 hover:text-accent"
          >
            {credit.nome}
          </a>
        ) : (
          <span class="font-semibold text-surface/90">{credit.nome}</span>
        )}
      </p>
    </div>

  </div>
</footer>