---
import { SITE } from "../config/site";

interface Props {
  titulo?: string;
  texto?: string;
  botaoTexto?: string;
  botaoHref?: string;
}

const {
  titulo = "Not sure where to start?",
  texto = "There are a few different ways we can work together. Find the one that fits what you're looking for.",
  botaoTexto = SITE.cta.texto,
  botaoHref = SITE.cta.href,
} = Astro.props;
---

<section class="bg-sand px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto flex max-w-[1280px] flex-col items-start gap-8 md:flex-row md:items-end md:justify-between md:gap-16">
    <div class="max-w-[640px]">
      <h2 class="font-display text-[38px] font-light leading-[1.08] tracking-[-0.015em] text-brand md:text-[56px]">
        {titulo}
      </h2>
      <p class="mt-5 max-w-[52ch] text-[17px] leading-[1.65] text-ink/80 md:text-[18px]">
        {texto}
      </p>
    </div>

    <a
      href={botaoHref}
      class="inline-flex shrink-0 rounded-full bg-brand px-9 py-4 text-[17px] font-semibold text-surface transition-colors duration-300 hover:bg-brand-light"
    >
      {botaoTexto}
    </a>
  </div>
</section>