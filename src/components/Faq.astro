---
interface Pergunta {
  pergunta: string;
  resposta: string;
}

interface Props {
  /** Primeira parte do título. */
  titulo?: string;
  /** Continuação do título. No mobile vai para a segunda linha (amarela); no desktop fica junto da primeira, em azul. */
  tituloLinha2?: string;
  perguntas?: Pergunta[];
  id?: string;
}

const {
  titulo = "Frequently",
  tituloLinha2 = "Asked Questions",
  perguntas = [
    {
      pergunta: "Where does the training take place?",
      resposta: "Training takes place at Beauty Beneath The Needle, 94 Main Road, Gedling, NG4 3HG.",
    },
    {
      pergunta: "Is the training 1-1?",
      resposta: "Yes, training is delivered on a personalised 1-1 basis.",
    },
    {
      pergunta: "Will I work on models?",
      resposta: "Yes. The training includes extensive model practice to help you develop practical confidence.",
    },
    {
      pergunta: "Is this suitable for beginners?",
      resposta: "The Pathway to Aesthetics is designed to provide a foundation in anatomy, safety and core aesthetics treatments.",
    },
    {
      pergunta: "Do I receive a certificate after completing the training?",
      resposta: "Yes. Upon successful completion of your training, you will receive certification for the treatments covered in your course.",
    },
    {
      pergunta: "Is ongoing support included after my training?",
      resposta: "Yes. You'll receive ongoing support after your training, so you don't have to navigate your aesthetics journey alone.",
    },
  ],
  id = "faq",
} = Astro.props;

// Dados estruturados para o Google (FAQ rich results)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: perguntas.map((p) => ({
    "@type": "Question",
    name: p.pergunta,
    acceptedAnswer: { "@type": "Answer", text: p.resposta },
  })),
};
---

<section id={id} class="scroll-mt-4 bg-white px-[20px] py-[24px] text-ink md:px-[96px] md:py-[82px]">
  <div class="reveal mx-auto max-w-[800px]">

    <!-- Título: mobile = 2 linhas (segunda em amarelo), desktop = 1 linha toda em azul -->
    <h2 class="text-center font-sans text-[34px] font-[600] leading-[1.15] tracking-[-0.03em] text-brand md:text-[46px]">
      {titulo}{" "}<br class="md:hidden" /><span class="text-accent md:text-brand">{tituloLinha2}</span>
    </h2>

    <div class="mt-[32px] flex flex-col gap-[12px] md:mt-[56px] md:gap-[16px]">
      {perguntas.map((item) => (
        <details class="group rounded-[20px] border border-brand/15 bg-surface p-[20px] transition-colors duration-300 open:bg-white open:shadow-[0_12px_40px_-20px_rgba(0,0,0,0.25)] md:px-[32px] md:py-[24px]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-[16px] font-sans text-[20px] font-[600] leading-[1.3] tracking-[-0.01em] text-brand md:text-[22px] [&::-webkit-details-marker]:hidden">
            {item.pergunta}
            <span class="flex h-[32px] w-[32px] shrink-0 items-center justify-center rounded-full bg-brand text-white transition-transform duration-300 group-open:rotate-180 group-open:bg-accent group-open:text-brand">
              <svg viewBox="0 0 24 24" class="h-[16px] w-[16px]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </summary>
          <p class="mt-[16px] font-sans text-[19px] leading-[1.5] text-ink/80 md:text-[20px]">
            {item.resposta}
          </p>
        </details>
      ))}
    </div>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>