---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";

/* TEXTO BASE: revisar com a Stephanie (e, se possível, com um profissional jurídico)
   antes de publicar, principalmente o que depende de ferramentas reais do site
   (análise de visitas, serviço do formulário, hospedagem). */
const atualizado = "[add date]";
const contato = SITE.social.email || "the Contact page";

const secoes = [
  {
    titulo: "What I collect",
    texto: [
      "When you send a message through the contact form, I collect the details you choose to share: your name, email address, phone number (optional), what you're interested in and your message.",
      "If I use analytics or similar tools on this site, they may collect general, non-identifying information about how visitors use it, such as pages viewed and device type.",
    ],
  },
  {
    titulo: "How I use it",
    texto: [
      "I use your information to reply to your message, discuss appointments, education, mentorship or the online business, and to keep a record of our conversation. I don't sell your personal information.",
    ],
  },
  {
    titulo: "Who it may be shared with",
    texto: [
      "Your information may pass through the services that run this site, such as the website host and the form or email provider that delivers your message to me. They only handle it to provide those services.",
    ],
  },
  {
    titulo: "How long I keep it",
    texto: [
      "I keep your information for as long as it's needed to respond to you and manage our working relationship, or as required by law.",
    ],
  },
  {
    titulo: "Your choices",
    texto: [
      `You can ask to see, correct or delete the personal information I hold about you by contacting me through ${contato}.`,
    ],
  },
  {
    titulo: "Links to other sites",
    texto: [
      "This site may link to other websites and social platforms. I'm not responsible for their privacy practices, so please read their policies.",
    ],
  },
  {
    titulo: "Changes to this policy",
    texto: ["I may update this policy from time to time. The date at the top shows when it was last changed."],
  },
];
---

<BaseLayout
  title="Privacy Policy | The Infinite Collective"
  description="How The Infinite Collective collects, uses and protects the information you share through this website."
>
  <section class="px-5 pb-20 pt-8 md:px-10 md:pb-32 md:pt-16">
    <div class="mx-auto grid max-w-[1280px] gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h1 class="font-display text-[44px] font-light leading-[1.02] tracking-[-0.025em] text-brand md:text-[72px]">
          Privacy policy
        </h1>
        <p class="mt-5 text-[16px] text-muted">Last updated: {atualizado}</p>
      </div>

      <div class="flex flex-col gap-10 lg:col-span-7">
        {secoes.map((s) => (
          <div>
            <h2 class="font-display text-[26px] font-medium leading-[1.15] text-brand md:text-[30px]">{s.titulo}</h2>
            <div class="mt-3 flex flex-col gap-4 text-[17px] leading-[1.7] text-ink/85">
              {s.texto.map((p) => <p class="max-w-[60ch]">{p}</p>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>