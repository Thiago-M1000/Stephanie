---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkWithMeCta from "../components/WorkWithMeCta.astro";
import HeroTest from "../components/HeroTest.astro";
import Button from "../components/Button.astro";
import { SITE } from "../config/site";

/* Troque fotoHero pela nova foto profissional quando ela estiver em public/images. */
const temFotoHero = true;
const fotoHero = "/images/img6.webp";
const fotoPosMobile = "35% 0%";
const fotoPosDesktop = "50% 0%";
const temFotoSobre = true;
const fotoSobre = "/images/img2.webp";

/* Preencha foto com um caminho de /public/images para usar uma imagem no card.
   fotoPos define o enquadramento como "X% Y%". */
const caminhos = [
  {
    publico: "For clients",
    titulo: "Beauty Services",
    frase: "Come sit in my chair.",
    texto:
      "Bringing a higher standard of luxury beauty services to the Okanagan. From structured gel nails to lashes and brows, every service is approached with care, intention and attention to detail. With a focus on education, quality products and techniques that support long term health, my goal is to create beautiful, lasting results while making sure every client feels comfortable, confident and cared for.",
    botao: "Explore beauty services",
    href: "/beauty-services",
    foto: "",
    fotoPos: "50% 30%",
    painel: "bg-sand text-ink",
    botaoClasses: "bg-brand text-surface group-hover:bg-brand-dark",
  },
  {
    publico: "For beauty professionals",
    titulo: "Education + Mentorship",
    frase: "Ready to grow your skills or your business?",
    texto:
      "Great education goes beyond learning a technique. From technical training to business mentorship, my approach focuses on understanding the why, building confidence and creating a community where continued support and collaboration help you grow long after the initial training.",
    botao: "Explore education + mentorship",
    href: "/education-mentorship",
    foto: "",
    fotoPos: "50% 30%",
    painel: "bg-taupe text-ink",
    botaoClasses: "bg-brand text-surface group-hover:bg-brand-dark",
  },
  {
    publico: "For anyone, from any industry",
    titulo: "Online Business",
    frase: "Looking to build income differently?",
    texto:
      "For those looking to create an additional income stream outside of traditional service based work, this is the online business I've chosen to build alongside my existing business. You don't need to be an influencer or have previous experience. What matters is being open to learning, willing to put in the work and ready to build something of your own.",
    botao: "Explore the online business",
    href: "/online-business",
    foto: "",
    fotoPos: "50% 30%",
    painel: "bg-brand text-surface",
    botaoClasses: "bg-surface text-brand group-hover:bg-sand",
  },
];

const degradeCard = "linear-gradient(to top, #000000E6 0%, #000000B3 50%, #00000066 100%)";

const destaques = [
  { destaque: "10+", descricao: "Years in the beauty industry" },
  { destaque: "3×", descricao: "Canadian Choice Award winner" },
  { destaque: "International", descricao: "Education and training" },
];
---

<BaseLayout
  title="The Infinite Collective | Beauty, Education + Business"
  description="One brand, multiple ways to work together: beauty services, education + mentorship and an online business, all with Stephanie."
>
  <HeroTest
    titulo={SITE.name}
    subtitulo="Beauty • Education • Business"
    frase="More than one way to grow."
    texto="Bringing together my passion for beauty, education, mentorship and entrepreneurship. Different opportunities, one collective built around connection, community and helping others grow."
    foto={temFotoHero ? fotoHero : undefined}
    fotoPos={fotoPosDesktop}
    fotoPosMobile={fotoPosMobile}
    larguraTitulo="14ch"
  >
    <Button href="#paths" variante="claro">Find your path</Button>
  </HeroTest>

  <section id="paths" class="mt-10 scroll-mt-20 px-5 md:mt-16 md:px-10 xl:scroll-mt-24" aria-label="Three ways to work together">
    <div class="reveal mx-auto grid max-w-[1280px] gap-5 lg:grid-cols-3">
      {caminhos.map((c) => (
        <article
          class:list={[
            "group relative isolate flex min-w-0 flex-col overflow-hidden rounded-[24px] p-7 sm:p-8 xl:p-10",
            c.foto ? "bg-brand text-surface" : c.painel,
          ]}
        >
          {c.foto && (
            <>
              <img
                src={c.foto}
                alt=""
                class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                style={`object-position: ${c.fotoPos}`}
                loading="lazy"
              />
              <div class="absolute inset-0 -z-10" style={`background: ${degradeCard}`}></div>
            </>
          )}

          <p class="text-[15px] font-medium opacity-75">{c.publico}</p>
          <h2 class="mt-4 font-display text-[38px] font-medium leading-[1.05] tracking-[-0.02em] md:text-[46px]">
            {c.titulo}
          </h2>
          <p class="mt-3 max-w-[22ch] font-display text-[22px] italic leading-[1.25] opacity-85 md:text-[25px]">
            {c.frase}
          </p>

          <div class="mt-auto pt-6">
            <p class="max-w-[40ch] text-[16px] leading-[1.65] opacity-90">
              {c.texto}
            </p>
            <a
              href={c.href}
              class:list={[
                "mt-8 inline-flex rounded-full px-7 py-3 text-[16px] font-semibold uppercase transition-colors duration-300 after:absolute after:inset-0",
                c.foto ? "bg-surface text-brand group-hover:bg-sand" : c.botaoClasses,
              ]}
            >
              {c.botao}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="px-5 py-20 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1280px]">
      <div class="grid items-center gap-10 md:grid-cols-12 md:gap-8">
        {temFotoSobre && (
          <div class="md:col-span-5">
            <img
              src={fotoSobre}
              alt="Stephanie"
              class="aspect-[4/5] w-full rounded-[28px] object-cover"
              style="object-position: 50% 20%"
              loading="lazy"
            />
          </div>
        )}

        <div class:list={[temFotoSobre ? "md:col-span-6 md:col-start-7" : "md:col-span-9"]}>
          <h2 class="font-display text-[38px] font-light leading-[1.08] tracking-[-0.015em] text-brand md:text-[56px]">
            Meet Stephanie
          </h2>
          <div class="mt-6 max-w-[52ch] space-y-4 text-[17px] leading-[1.7] text-ink/80 md:text-[19px]">
            <p>
              I am an award winning beauty business owner, educator, mentor and entrepreneur with over a decade of experience building businesses around the things I'm passionate about.
            </p>
            <p>
              What started behind the treatment table has grown into something much bigger, with a passion for bringing people together through meaningful connections, collaboration and community. I believe success is even more rewarding when we create opportunities to learn from one another, support each other's growth and build something greater together.
            </p>
          </div>
          <div class="mt-8 uppercase">
            <Button href="/about">Read my story</Button>
          </div>
        </div>
      </div>

      <section
        aria-labelledby="stephanie-credentials"
        class="mt-14 rounded-[28px] bg-sand px-5 py-8 text-center md:mt-20 md:px-8 md:py-10"
      >
        <h3 id="stephanie-credentials" class="font-display text-[28px] font-medium leading-tight text-brand md:text-[34px]">
          Experience &amp; Recognition
        </h3>
        <ul class="mt-6 grid divide-y divide-brand/15 border-t border-brand/15 md:grid-cols-3 md:divide-x md:divide-y-0">
          {destaques.map(({ destaque, descricao }) => (
            <li class="px-3 py-5 md:pt-7 md:pb-2">
              <span class="block font-display text-[34px] font-medium leading-none tracking-tight text-brand lg:text-[42px]">
                {destaque}
              </span>
              <span class="mt-2 block text-[16px] leading-snug text-ink/80">
                {descricao}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  <WorkWithMeCta />
</BaseLayout>
