---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import HeroSlider from "../components/HeroSlider.astro";
import VideoIntro from "../components/VideoIntro.astro";
import { SITE } from "../config/site";
import KnowledgeSection from "../components/KnowledgeSection.astro";
import LearnByDoing from "../components/LearnByDoing.astro";
import Story from "../components/Story.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import Footer2 from "../components/Footer2.astro";


const sobreHelen = [
  "Helen Hinchliff is a Registered Nurse, award-winning aesthetics practitioner and founder of Beauty Beneath The Needle.",
  "Her training combines hands-on experience, clinical knowledge and a strong focus on patient safety — giving students the confidence to develop their skills in a professional environment.",
];

const credenciais = ["Registered Nurse", "MABA Awards Winner 2024", "TLA Awards Winner 2026"];
---

<BaseLayout
  title="Pathway to Aesthetics Training | Helen Hinchliff"
  description="Build the skills, confidence and knowledge to begin your journey in aesthetics."
>
  <Navbar
    nome="Beauty Beneath the Needle"
    links={SITE.nav}
    ctaTexto="Enroll now"
    ctaHref={`mailto:${SITE.social.email}`}
  />

  <HeroSlider
    titulo="Pathway to aesthetics"
    subtitulo="Build the skills, confidence and knowledge to begin your journey in aesthetics."
    destaques={["1-1 Training", "Extensive Model Practice", "Ongoing Support", "Registered Nurse"]}
    slides={[
      { imagem: "/images/img4.webp", alt: "Helen Hinchliff training a student", pos: "50% 10%", posMobile: "55% 20%" },
    ]}
  />

  <VideoIntro
    titulo="Learn from someone who lives it every day."
    tituloDestaque="who lives it every day."
    video="/videos/video1.mp4"
    paragrafos={sobreHelen}
    credenciais={credenciais}
  />

  <KnowledgeSection
  imagem="/images/img1.webp"
  alt="Practitioner studying facial anatomy"
  imgPos="50% 30%"
/>

<LearnByDoing video="/videos/video2.mp4"/>

<Story video="/videos/video4.mp4"/>

<Pricing/>
<Faq/>
<Footer2/>

</BaseLayout>