---
import BaseLayout from "../layouts/BaseLayout.astro";

const areas = [
  "Pricing",
  "Branding",
  "Client experience",
  "Social media",
  "Content creation",
  "Marketing",
  "Systems",
  "Business direction",
  "Goal setting",
  "Accountability",
  "Mindset",
  "Growth strategies",
];
---

<BaseLayout
  title="Business Mentorship | The Infinite Collective"
  description="1:1 mentorship for service providers who want personalized guidance, accountability and support while building, refining or growing their business."
>
  <section class="px-5 pb-16 pt-8 md:px-10 md:pb-24 md:pt-16">
    <div class="mx-auto max-w-[1280px]">
      <h1 class="max-w-[14ch] font-display text-[44px] font-light leading-[1.02] tracking-[-0.025em] text-brand md:text-[84px]">
        Build the business behind your skills.
      </h1>
      <div class="mt-8 flex max-w-[56ch] flex-col gap-5 text-[17px] leading-[1.7] text-ink/85 md:text-[19px]">
        <p>
          1:1 mentorship for service providers who want personalized guidance, accountability and support while building, refining or growing their business.
        </p>
        <p>
          Rather than following one generic business formula, mentorship is guided by you, your business, your current challenges and what you're working toward.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-sand px-5 py-16 md:px-10 md:py-24">
    <div class="mx-auto grid max-w-[1280px] gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="font-display text-[32px] font-medium leading-[1.1] tracking-[-0.015em] text-brand md:text-[42px]">
          Areas we can work on
        </h2>
        <p class="mt-6 max-w-[40ch] text-[17px] leading-[1.7] text-ink/85">
          This is designed for both newer professionals building strong foundations and experienced professionals who feel ready for their next stage of growth.
        </p>
      </div>
      <ul class="grid gap-x-8 border-t border-brand/20 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
        {areas.map((a) => (
          <li class="border-b border-brand/20 py-3 text-[17px] leading-[1.4] text-ink">{a}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-5 py-20 md:px-10 md:py-28">
    <div class="mx-auto flex max-w-[1280px] flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <p class="max-w-[22ch] font-display text-[32px] font-light leading-[1.1] tracking-[-0.015em] text-brand md:text-[48px]">
        Ready to talk about your business?
      </p>
      <a
        href="/contact"
        class="inline-flex rounded-full bg-brand px-9 py-4 text-[17px] font-semibold text-surface transition-colors duration-300 hover:bg-brand-light"
      >
        Start a conversation
      </a>
    </div>
  </section>
</BaseLayout>