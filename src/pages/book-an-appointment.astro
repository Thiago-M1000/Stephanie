---
import BaseLayout from "../layouts/BaseLayout.astro";

/* TODO: colocar o contato preferido da Stephanie (abre direto, sem chatbot).
   Exemplos: "https://ig.me/m/usuario", "https://wa.me/5500000000000", "mailto:email@site.com" */
const contatoHref = "#";
---

<BaseLayout
  title="Book an Appointment | The Infinite Collective"
  description="Start with a conversation. Message Stephanie directly to find the right appointment for you."
>
  <section class="px-5 pb-20 pt-8 md:px-10 md:pb-32 md:pt-16">
    <div class="mx-auto grid max-w-[1280px] gap-10 lg:grid-cols-12 lg:gap-8">

      <div class="lg:col-span-6">
        <h1 class="font-display text-[44px] font-light leading-[1.02] tracking-[-0.025em] text-brand md:text-[76px]">
          Let's find the right appointment for you.
        </h1>
      </div>

      <div class="lg:col-span-5 lg:col-start-8">
        <div class="flex flex-col gap-5 text-[17px] leading-[1.7] text-ink/85 md:text-[18px]">
          <p>
            Every appointment at Infinite Beauty is a little different, because every client is a little different.
          </p>
          <p>
            Rather than asking you to choose from a long list of services and hope you've booked the right thing, I prefer to start with a conversation.
          </p>
          <p>
            When you reach out, you're talking directly to me, not a bot or an automated booking system.
          </p>
          <p>
            We'll chat about what you're looking for, what you're currently working with, your goals and anything else I need to know to determine whether the services I offer are the right fit. I'll also be completely transparent if I don't think what I offer is the right match.
          </p>
          <p>
            Once we know exactly what you need, I'll guide you through the booking process and make sure the correct service and amount of time are reserved for your appointment.
          </p>
        </div>

        <p class="mt-8 font-display text-[24px] italic leading-[1.3] text-brand md:text-[28px]">
          Personalized from the very first conversation, because your appointment should be designed around you.
        </p>

        <a
          href={contatoHref}
          class="mt-10 inline-flex rounded-full bg-brand px-9 py-4 text-[17px] font-semibold text-surface transition-colors duration-300 hover:bg-brand-light"
        >
          Message Stephanie to book
        </a>
      </div>

    </div>
  </section>
</BaseLayout>