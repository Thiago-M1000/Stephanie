---
import BaseLayout from "../layouts/BaseLayout.astro";

/* Preencha o campo "texto" de cada seção quando a Stephanie enviar as políticas.
   Cada item do array vira um parágrafo. Seções com a lista vazia mostram um aviso. */
const secoes: { titulo: string; texto: string[] }[] = [
  {
    titulo: "New clients",
    texto: [
      "When you reach out, you're talking directly to me. Before booking, I may ask about what you're currently wearing or working with and request a few photos, so I can recommend the right service and book the right amount of time.",
    ],
  },
  { titulo: "Appointment preparation", texto: [] },
  { titulo: "Cancellation + rescheduling policy", texto: [] },
  { titulo: "Late arrivals", texto: [] },
  { titulo: "Deposits", texto: [] },
  { titulo: "Fills / work from other artists", texto: [] },
  { titulo: "Allergies, sensitivities + contraindications", texto: [] },
  { titulo: "Location + parking", texto: [] },
];
---

<BaseLayout
  title="Beauty FAQs + Policies | The Infinite Collective"
  description="Everything to know before booking or attending a beauty appointment: new clients, preparation, cancellations, deposits, location and more."
>
  <section class="px-5 pb-20 pt-8 md:px-10 md:pb-32 md:pt-16">
    <div class="mx-auto grid max-w-[1280px] gap-10 lg:grid-cols-12 lg:gap-8">

      <div class="lg:col-span-5">
        <h1 class="font-display text-[44px] font-light leading-[1.02] tracking-[-0.025em] text-brand md:text-[76px]">
          Beauty FAQs + policies
        </h1>
        <p class="mt-6 max-w-[40ch] text-[17px] leading-[1.65] text-ink/80 md:text-[18px]">
          A place to check the details before you book or come in for your appointment.
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="border-t border-brand/15">
          {secoes.map((s, i) => (
            <details class="group border-b border-brand/15" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-display text-[24px] font-medium leading-[1.2] text-brand md:text-[28px] [&::-webkit-details-marker]:hidden">
                {s.titulo}
                <span class="relative block h-4 w-4 shrink-0" aria-hidden="true">
                  <span class="absolute left-0 top-1/2 h-[2px] w-4 -translate-y-1/2 bg-brand"></span>
                  <span class="absolute left-1/2 top-0 h-4 w-[2px] -translate-x-1/2 bg-brand transition-transform duration-300 group-open:scale-y-0"></span>
                </span>
              </summary>
              <div class="flex flex-col gap-4 pb-8 text-[17px] leading-[1.7] text-ink/85">
                {s.texto.length > 0 ? (
                  s.texto.map((p) => <p class="max-w-[58ch]">{p}</p>)
                ) : (
                  <p class="max-w-[58ch] text-muted">Details for this section will be added soon.</p>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>